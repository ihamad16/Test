//==============================================================================
//  FC 26 - Splash Screen (Option 1: Simple Text)
//  Platform    : PlayStation / Cronus Zen
//  Version     : 1.2
//  Description : يعرض "FC 26 / VIP" عند تشغيل السكريبت
//  Note        : بانتظار تأكيد صيغة OLED text الصحيحة من Dark.Angel
//==============================================================================

define SPLASH_DURATION = 3000;   // مدة عرض الشعار بالميلي ثانية

int splash_done = FALSE;
int splash_timer = 0;

init {
    cls_oled(0);                 // مسح شاشة OLED (مؤكد شغّال)
    printf("FC 26 VIP");         // يطبع في Zen Studio debug terminal
}

main {
    if(!splash_done) {
        splash_timer = splash_timer + get_rtime();
        if(splash_timer >= SPLASH_DURATION) {
            splash_done = TRUE;
        }
    }
}

