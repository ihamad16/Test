// Remap routing temp vars
int o_l1, o_r1, o_l2, o_r2, o_cross, o_circle, o_square, o_triangle;
int n_l1, n_r1, n_l2, n_r2, n_cross, n_circle, n_square, n_triangle;
int route_dest;
int cycle_tmp;
