// طباعة اسم الزر للدبل تاب (0..10 أزرار، 11 = Off)
function print_dbl_btn_name(idx, x, y, font) {
    if(idx == 0)       print(x, y, font, OLED_WHITE, BTN_L1[0]);
    else if(idx == 1)  print(x, y, font, OLED_WHITE, BTN_R1[0]);
    else if(idx == 2)  print(x, y, font, OLED_WHITE, BTN_L2[0]);
    else if(idx == 3)  print(x, y, font, OLED_WHITE, BTN_R2[0]);
    else if(idx == 4)  print(x, y, font, OLED_WHITE, BTN_CR[0]);
    else if(idx == 5)  print(x, y, font, OLED_WHITE, BTN_CI[0]);
    else if(idx == 6)  print(x, y, font, OLED_WHITE, BTN_SQ[0]);
    else if(idx == 7)  print(x, y, font, OLED_WHITE, BTN_TR[0]);
    else if(idx == 8)  print(x, y, font, OLED_WHITE, BTN_L3[0]);
    else if(idx == 9)  print(x, y, font, OLED_WHITE, BTN_R3[0]);
    else if(idx == 10) print(x, y, font, OLED_WHITE, BTN_TP[0]);
    else if(idx == 11) print(x, y, font, OLED_WHITE, BTN_SWUP[0]);
    else if(idx == 12) print(x, y, font, OLED_WHITE, BTN_SWDN[0]);
    else if(idx == 13) print(x, y, font, OLED_WHITE, BTN_SWLF[0]);
    else if(idx == 14) print(x, y, font, OLED_WHITE, BTN_SWRG[0]);
    else if(idx == 15) print(x, y, font, OLED_WHITE, BTN_DUP[0]);
    else if(idx == 16) print(x, y, font, OLED_WHITE, BTN_DDN[0]);
    else if(idx == 17) print(x, y, font, OLED_WHITE, BTN_DLF[0]);
    else if(idx == 18) print(x, y, font, OLED_WHITE, BTN_DRG[0]);
    else if(idx == 19) print(x, y, font, OLED_WHITE, STR_OFF[0]);
}

