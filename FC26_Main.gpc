//==============================================================================
//  BUTTON REMAP ENGINE
//==============================================================================
function apply_remap() {
    o_l1       = get_val(PS4_L1);
    o_r1       = get_val(PS4_R1);
    o_l2       = get_val(PS4_L2);
    o_r2       = get_val(PS4_R2);
    o_cross    = get_val(PS4_CROSS);
    o_circle   = get_val(PS4_CIRCLE);
    o_square   = get_val(PS4_SQUARE);
    o_triangle = get_val(PS4_TRIANGLE);

    n_l1 = 0; n_r1 = 0; n_l2 = 0; n_r2 = 0;
    n_cross = 0; n_circle = 0; n_square = 0; n_triangle = 0;

    route_value(o_l1,       tgt_l1,       0);
    route_value(o_r1,       tgt_r1,       1);
    route_value(o_l2,       tgt_l2,       2);
    route_value(o_r2,       tgt_r2,       3);
    route_value(o_cross,    tgt_cross,    4);
    route_value(o_circle,   tgt_circle,   5);
    route_value(o_square,   tgt_square,   6);
    route_value(o_triangle, tgt_triangle, 7);

    set_val(PS4_L1,       n_l1);
    set_val(PS4_R1,       n_r1);
    set_val(PS4_L2,       n_l2);
    set_val(PS4_R2,       n_r2);
    set_val(PS4_CROSS,    n_cross);
    set_val(PS4_CIRCLE,   n_circle);
    set_val(PS4_SQUARE,   n_square);
    set_val(PS4_TRIANGLE, n_triangle);
}

function route_value(orig_val, target, source_idx) {
    route_dest = target;
    if(route_dest == TGT_DEFAULT) route_dest = source_idx;

    if(route_dest == 0)      { if(orig_val > n_l1)       n_l1       = orig_val; }
    else if(route_dest == 1) { if(orig_val > n_r1)       n_r1       = orig_val; }
    else if(route_dest == 2) { if(orig_val > n_l2)       n_l2       = orig_val; }
    else if(route_dest == 3) { if(orig_val > n_r2)       n_r2       = orig_val; }
    else if(route_dest == 4) { if(orig_val > n_cross)    n_cross    = orig_val; }
    else if(route_dest == 5) { if(orig_val > n_circle)   n_circle   = orig_val; }
    else if(route_dest == 6) { if(orig_val > n_square)   n_square   = orig_val; }
    else if(route_dest == 7) { if(orig_val > n_triangle) n_triangle = orig_val; }
}

function get_target_for_btn(idx) {
    if(idx == 0) return tgt_l1;
    if(idx == 1) return tgt_r1;
    if(idx == 2) return tgt_l2;
    if(idx == 3) return tgt_r2;
    if(idx == 4) return tgt_cross;
    if(idx == 5) return tgt_circle;
    if(idx == 6) return tgt_square;
    if(idx == 7) return tgt_triangle;
    return TGT_DEFAULT;
}

function set_target_for_btn(idx, val) {
    if(idx == 0) tgt_l1 = val;
    else if(idx == 1) tgt_r1 = val;
    else if(idx == 2) tgt_l2 = val;
    else if(idx == 3) tgt_r2 = val;
    else if(idx == 4) tgt_cross = val;
    else if(idx == 5) tgt_circle = val;
    else if(idx == 6) tgt_square = val;
    else if(idx == 7) tgt_triangle = val;
}

function cycle_target(idx, dir) {
    cycle_tmp = get_target_for_btn(idx) + dir;
    if(cycle_tmp > 8) cycle_tmp = 0;
    if(cycle_tmp < 0) cycle_tmp = 8;
    set_target_for_btn(idx, cycle_tmp);
}

function cycle_finesse_shortcut(dir) {
    finesse_shortcut = finesse_shortcut + dir;
    if(finesse_shortcut > SH_DISABLED) finesse_shortcut = 0;
    if(finesse_shortcut < 0) finesse_shortcut = SH_DISABLED;
}

function cycle_finesse_dbl(dir) {
    finesse_dbl_btn = finesse_dbl_btn + dir;
    if(finesse_dbl_btn > DBL_OFF) finesse_dbl_btn = 0;
    if(finesse_dbl_btn < 0) finesse_dbl_btn = DBL_OFF;
}

function cycle_trivela_dbl(dir) {
    trivela_dbl_btn = trivela_dbl_btn + dir;
    if(trivela_dbl_btn > DBL_OFF) trivela_dbl_btn = 0;
    if(trivela_dbl_btn < 0) trivela_dbl_btn = DBL_OFF;
}

function cycle_skill_dbl(dir, current) {
    cycle_tmp = current + dir;
    if(cycle_tmp > DBL_OFF) cycle_tmp = 0;
    if(cycle_tmp < 0) cycle_tmp = DBL_OFF;
    return cycle_tmp;
}

// Helper: هل الزر/السحبة/السهم المختار ضُغط الآن؟ (0..18)
function is_dbl_btn_pressed(btn) {
    if(btn == 0  && event_press(PS4_L1))       return 1;
    if(btn == 1  && event_press(PS4_R1))       return 1;
    if(btn == 2  && event_press(PS4_L2))       return 1;
    if(btn == 3  && event_press(PS4_R2))       return 1;
    if(btn == 4  && event_press(PS4_CROSS))    return 1;
    if(btn == 5  && event_press(PS4_CIRCLE))   return 1;
    if(btn == 6  && event_press(PS4_SQUARE))   return 1;
    if(btn == 7  && event_press(PS4_TRIANGLE)) return 1;
    if(btn == 8  && event_press(PS4_L3))       return 1;
    if(btn == 9  && event_press(PS4_R3))       return 1;
    if(btn == 10 && event_press(PS4_TOUCH))    return 1;
    // سحبات (لا نستهلك last_swipe لأن العداد ينضرب مرتين كل سحبة جديدة)
    if(btn == 11 && last_swipe == 1) return 1;
    if(btn == 12 && last_swipe == 2) return 1;
    if(btn == 13 && last_swipe == 3) return 1;
    if(btn == 14 && last_swipe == 4) return 1;
    if(btn == 15 && event_press(PS4_UP))       return 1;
    if(btn == 16 && event_press(PS4_DOWN))     return 1;
    if(btn == 17 && event_press(PS4_LEFT))     return 1;
    if(btn == 18 && event_press(PS4_RIGHT))    return 1;
    return 0;
}

// كشف الدبل تاب للفينس: نمط مرجعي
function check_finesse_dbl_tap() {
    if(finesse_dbl_btn == DBL_OFF) return 0;
    if(finesse_dbl_timer > 0) {
        finesse_dbl_timer = finesse_dbl_timer - get_rtime();
        if(finesse_dbl_timer <= 0) finesse_dbl_count = 0;
    }
    if(is_dbl_btn_pressed(finesse_dbl_btn)) {
        finesse_dbl_count = finesse_dbl_count + 1;
        if(finesse_dbl_count >= 2) {
            finesse_dbl_count = 0;
            finesse_dbl_timer = 0;
            return 1;
        }
        finesse_dbl_timer = DBL_TAP_WINDOW;
    }
    return 0;
}

function check_trivela_dbl_tap() {
    if(trivela_dbl_btn == DBL_OFF) return 0;
    if(trivela_dbl_timer > 0) {
        trivela_dbl_timer = trivela_dbl_timer - get_rtime();
        if(trivela_dbl_timer <= 0) trivela_dbl_count = 0;
    }
    if(is_dbl_btn_pressed(trivela_dbl_btn)) {
        trivela_dbl_count = trivela_dbl_count + 1;
        if(trivela_dbl_count >= 2) {
            trivela_dbl_count = 0;
            trivela_dbl_timer = 0;
            return 1;
        }
        trivela_dbl_timer = DBL_TAP_WINDOW;
    }
    return 0;
}

