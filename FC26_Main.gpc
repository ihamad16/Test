//  SAVE
//==============================================================================
function save_settings() {
    set_pvar(SPVAR_1,  mod_sprint);
    set_pvar(SPVAR_2,  sprint_power);
    set_pvar(SPVAR_3,  mod_remap);
    set_pvar(SPVAR_4,  tgt_l1);
    set_pvar(SPVAR_5,  tgt_r1);
    set_pvar(SPVAR_6,  tgt_l2);
    set_pvar(SPVAR_7,  tgt_r2);
    set_pvar(SPVAR_8,  tgt_cross);
    set_pvar(SPVAR_9,  tgt_circle);
    set_pvar(SPVAR_10, tgt_square);
    set_pvar(SPVAR_11, tgt_triangle);
    set_pvar(SPVAR_12, mod_finesse);
    set_pvar(SPVAR_13, finesse_power);
    set_pvar(SPVAR_40, finesse_shortcut);
    set_pvar(SPVAR_16, mod_trivela);
    set_pvar(SPVAR_17, trivela_power);
    set_pvar(SPVAR_41, trivela_shortcut);
    set_pvar(SPVAR_19, mod_skills);
    set_pvar(SPVAR_30, sk_mcgeady_l);
    set_pvar(SPVAR_31, sk_mcgeady_r);
    set_pvar(SPVAR_32, sk_flair_nut);
    set_pvar(SPVAR_42, finesse_dbl_btn);
    set_pvar(SPVAR_43, trivela_dbl_btn);
    set_pvar(SPVAR_44, sk_mcgeady_l_dbl);
    set_pvar(SPVAR_45, sk_mcgeady_r_dbl);
    set_pvar(SPVAR_46, sk_flair_nut_dbl);
}
