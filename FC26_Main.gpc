    if(trivela_shortcut < 0) trivela_shortcut = SH_DISABLED;
}

//==============================================================================
//  MENU INPUT
//==============================================================================
function handle_menu_input() {
    if(event_press(PS4_CIRCLE)) {
        if(edit_open) {
            edit_open = FALSE;
            need_redraw = TRUE;
        } else {
            menu_open = FALSE;
            save_settings();
            cls_oled(0);
            print(center_x(5, OLED_FONT_SMALL_WIDTH), 18,
                  OLED_FONT_SMALL, OLED_WHITE, STR_SAVED[0]);
            saver_timer = 0;
            screen_saver = FALSE;
        }
        menu_timer = MENU_TIMEOUT;
    }

    if(event_press(PS4_CROSS)) {
        edit_open = !edit_open;
        need_redraw = TRUE;
        menu_timer = MENU_TIMEOUT;
    }

    if(!edit_open) {
        if(event_press(PS4_DOWN)) {
            menu_idx = menu_idx + 1;
            if(menu_idx > MAX_MODS) menu_idx = 0;
            need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
        }
        if(event_press(PS4_UP)) {
            menu_idx = menu_idx - 1;
            if(menu_idx < 0) menu_idx = MAX_MODS;
            need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
        }
        if(event_press(PS4_RIGHT)) {
            toggle_mod(1);
            need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
        }
        if(event_press(PS4_LEFT)) {
            toggle_mod(0);
            need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
        }
    } else {
        if(menu_idx == 0) {
            // Remap
            if(event_press(PS4_DOWN)) {
                remap_btn_idx = remap_btn_idx + 1;
                if(remap_btn_idx > 7) remap_btn_idx = 0;
                need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
            }
            if(event_press(PS4_UP)) {
                remap_btn_idx = remap_btn_idx - 1;
                if(remap_btn_idx < 0) remap_btn_idx = 7;
                need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
            }
            if(event_press(PS4_RIGHT)) {
                cycle_target(remap_btn_idx, 1);
                need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
            }
            if(event_press(PS4_LEFT)) {
                cycle_target(remap_btn_idx, -1);
                need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
            }
        } else if(menu_idx == 1) {
            // Finesse: ↑/↓ يبدل بين 3 خيارات، ←/→ يعدل القيمة
            if(event_press(PS4_DOWN)) {
                finesse_opt_idx = finesse_opt_idx + 1;
                if(finesse_opt_idx > 2) finesse_opt_idx = 0;
                need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
            }
            if(event_press(PS4_UP)) {
                finesse_opt_idx = finesse_opt_idx - 1;
                if(finesse_opt_idx < 0) finesse_opt_idx = 2;
                need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
            }
            if(event_press(PS4_RIGHT)) {
                if(finesse_opt_idx == 0)      finesse_power = clamp_val(finesse_power + 5, 50, 1500);
                else if(finesse_opt_idx == 1) cycle_finesse_shortcut(1);
                else                          cycle_finesse_dbl(1);
                need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
            }
            if(event_press(PS4_LEFT)) {
                if(finesse_opt_idx == 0)      finesse_power = clamp_val(finesse_power - 5, 50, 1500);
                else if(finesse_opt_idx == 1) cycle_finesse_shortcut(-1);
                else                          cycle_finesse_dbl(-1);
                need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
            }
        } else if(menu_idx == 2) {
            // Trivela: 3 خيارات مثل الفينس (Power, Short, Dbl)
            if(event_press(PS4_DOWN)) {
                trivela_opt_idx = trivela_opt_idx + 1;
                if(trivela_opt_idx > 2) trivela_opt_idx = 0;
                need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
            }
            if(event_press(PS4_UP)) {
                trivela_opt_idx = trivela_opt_idx - 1;
                if(trivela_opt_idx < 0) trivela_opt_idx = 2;
                need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
            }
            if(event_press(PS4_RIGHT)) {
                if(trivela_opt_idx == 0)      trivela_power = clamp_val(trivela_power + 5, 50, 1500);
                else if(trivela_opt_idx == 1) cycle_trivela_shortcut(1);
                else                          cycle_trivela_dbl(1);
                need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
            }
            if(event_press(PS4_LEFT)) {
                if(trivela_opt_idx == 0)      trivela_power = clamp_val(trivela_power - 5, 50, 1500);
                else if(trivela_opt_idx == 1) cycle_trivela_shortcut(-1);
                else                          cycle_trivela_dbl(-1);
                need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
            }
        } else if(menu_idx == 3) {
            // Sprint
            if(event_press(PS4_RIGHT)) {
                sprint_power = clamp_val(sprint_power + 10, 10, 100);
                need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
            }
            if(event_press(PS4_LEFT)) {
                sprint_power = clamp_val(sprint_power - 10, 10, 100);
                need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
            }
            if(event_press(PS4_UP)) {
                sprint_power = clamp_val(sprint_power + 1, 10, 100);
                need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
            }
            if(event_press(PS4_DOWN)) {
                sprint_power = clamp_val(sprint_power - 1, 10, 100);
                need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
            }
        } else if(menu_idx == 4) {
            // Skills: L1/R1 تنقل بين المهارات | ↑/↓ Short↔Dbl | ←/→ تغيير قيمة
            if(event_press(PS4_R1)) {
                skill_idx = skill_idx + 1;
                if(skill_idx > SKILLS_COUNT - 1) skill_idx = 0;
                need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
            }
            if(event_press(PS4_L1)) {
                skill_idx = skill_idx - 1;
                if(skill_idx < 0) skill_idx = SKILLS_COUNT - 1;
                need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
            }
            if(event_press(PS4_UP) || event_press(PS4_DOWN)) {
                skill_field = 1 - skill_field;
                need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
            }
            if(event_press(PS4_RIGHT)) {
                cycle_skill_field(1);
                need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
            }
            if(event_press(PS4_LEFT)) {
                cycle_skill_field(-1);
                need_redraw = TRUE; menu_timer = MENU_TIMEOUT;
            }
        }
    }
}

function toggle_mod(val) {
    if(menu_idx == 0) mod_remap = val;
    else if(menu_idx == 1) mod_finesse = val;
    else if(menu_idx == 2) mod_trivela = val;
    else if(menu_idx == 3) mod_sprint = val;
    else if(menu_idx == 4) mod_skills = val;
}

function clamp_val(v, mn, mx) {
    if(v < mn) return mn;
    if(v > mx) return mx;
    return v;
}

//==============================================================================
//  OLED DRAWING
//==============================================================================
function draw_frame() {
    rect_oled(0, 0, OLED_WIDTH, 64, FALSE, 1);
    line_oled(1, 15, 127, 15, 1, 1);
}

function draw_menu() {
    cls_oled(0);
    draw_frame();

    if(menu_idx == 0) draw_remap_menu();
    else if(menu_idx == 1) draw_finesse_menu();
    else if(menu_idx == 2) draw_trivela_menu();
    else if(menu_idx == 3) draw_sprint_menu();
    else if(menu_idx == 4) draw_skills_menu();
}

function draw_sprint_menu() {
    print(center_x(14, OLED_FONT_SMALL_WIDTH), 4,
          OLED_FONT_SMALL, OLED_WHITE, STR_MOD_SPRINT[0]);

    if(edit_open) {
        print_num_center(sprint_power, 22);
    } else {
        if(mod_sprint > 0) {
            print(center_x(7, OLED_FONT_SMALL_WIDTH), 22,
                  OLED_FONT_SMALL, OLED_WHITE, STR_ENABLED[0]);
        } else {
            print(center_x(8, OLED_FONT_SMALL_WIDTH), 22,
                  OLED_FONT_SMALL, OLED_WHITE, STR_DISABLED[0]);
        }
    }

    print(30, 40, OLED_FONT_SMALL, OLED_WHITE, STR_PWR_LBL[0]);
    print_num_at(sprint_power, 78, 40, OLED_FONT_SMALL);
}

function draw_remap_menu() {
    print(center_x(12, OLED_FONT_SMALL_WIDTH), 4,
          OLED_FONT_SMALL, OLED_WHITE, STR_MOD_REMAP[0]);

    if(edit_open) {
        draw_btn_mapping(remap_btn_idx);
    } else {
        if(mod_remap > 0) {
            print(center_x(7, OLED_FONT_SMALL_WIDTH), 22,
                  OLED_FONT_SMALL, OLED_WHITE, STR_ENABLED[0]);
        } else {
            print(center_x(8, OLED_FONT_SMALL_WIDTH), 22,
                  OLED_FONT_SMALL, OLED_WHITE, STR_DISABLED[0]);
        }
    }

    print(4, 40, OLED_FONT_SMALL, OLED_WHITE, STR_BTN_LBL[0]);
    print_num_at(remap_btn_idx + 1, 30, 40, OLED_FONT_SMALL);
}

function draw_finesse_menu() {
    print(center_x(12, OLED_FONT_SMALL_WIDTH), 4,
          OLED_FONT_SMALL, OLED_WHITE, STR_MOD_FINESSE[0]);

    if(edit_open) {
        // 3 خيارات مع مؤشر > على الحالي
        // الخيار 1: Power (y=18)
        if(finesse_opt_idx == 0) print(2, 18, OLED_FONT_SMALL, OLED_WHITE, STR_CURSOR[0]);
        print(12, 18, OLED_FONT_SMALL, OLED_WHITE, STR_PWR_LBL[0]);
        print_num_at(finesse_power, 58, 18, OLED_FONT_SMALL);

        // الخيار 2: Shortcut (y=29)
        if(finesse_opt_idx == 1) print(2, 29, OLED_FONT_SMALL, OLED_WHITE, STR_CURSOR[0]);
        print(12, 29, OLED_FONT_SMALL, OLED_WHITE, STR_SH_LBL[0]);
        print_shortcut_name(finesse_shortcut, 58, 29, OLED_FONT_SMALL);

        // الخيار 3: Double-Tap (y=40)
        if(finesse_opt_idx == 2) print(2, 40, OLED_FONT_SMALL, OLED_WHITE, STR_CURSOR[0]);
        print(12, 40, OLED_FONT_SMALL, OLED_WHITE, STR_DBL_LBL[0]);
        print_dbl_btn_name(finesse_dbl_btn, 58, 40, OLED_FONT_SMALL);
    } else {
        if(mod_finesse > 0) {
            print(center_x(7, OLED_FONT_SMALL_WIDTH), 20,
                  OLED_FONT_SMALL, OLED_WHITE, STR_ENABLED[0]);
        } else {
            print(center_x(8, OLED_FONT_SMALL_WIDTH), 20,
                  OLED_FONT_SMALL, OLED_WHITE, STR_DISABLED[0]);
        }
        // معلومات مختصرة
        print(4, 40, OLED_FONT_SMALL, OLED_WHITE, STR_PWR_LBL[0]);
        print_num_at(finesse_power, 36, 40, OLED_FONT_SMALL);
        print(70, 40, OLED_FONT_SMALL, OLED_WHITE, STR_DBL_LBL[0]);
        print_dbl_btn_name(finesse_dbl_btn, 95, 40, OLED_FONT_SMALL);
    }
}

