//------------------------------------------------------------------------------
// INIT
//------------------------------------------------------------------------------
init {
    // علم النسخة: SPVAR_50 لازم يساوي 42 إذا تم تهيئة الإعدادات الافتراضية مسبقاً.
    // لو لا، نكتب الـ shortcut defaults يدوياً (لأن Cronus يرجع 0 للـ PVAR غير المُهيّأ).
    if(get_pvar(SPVAR_50, 0, 99, 0) != 45) {
        set_pvar(SPVAR_40, 19);  // finesse_shortcut = Off
        set_pvar(SPVAR_41, 19);  // trivela_shortcut = Off
        set_pvar(SPVAR_42, 19);  // finesse_dbl_btn = Off
        set_pvar(SPVAR_30, 19);  // sk_mcgeady_l = Off
        set_pvar(SPVAR_31, 19);  // sk_mcgeady_r = Off
        set_pvar(SPVAR_32, 19);  // sk_flair_nut = Off
        set_pvar(SPVAR_43, 19);  // trivela_dbl_btn = Off
        set_pvar(SPVAR_44, 19);  // sk_mcgeady_l_dbl = Off
        set_pvar(SPVAR_45, 19);  // sk_mcgeady_r_dbl = Off
        set_pvar(SPVAR_46, 19);  // sk_flair_nut_dbl = Off
        set_pvar(SPVAR_50, 45);  // علامة تم تهيئة الافتراضيات
    }

    mod_sprint       = get_pvar(SPVAR_1,  0, 1,    1);
    sprint_power     = get_pvar(SPVAR_2,  10, 100, 50);
    mod_remap        = get_pvar(SPVAR_3,  0, 1,    0);
    tgt_l1           = get_pvar(SPVAR_4,  0, 8,    8);
    tgt_r1           = get_pvar(SPVAR_5,  0, 8,    8);
    tgt_l2           = get_pvar(SPVAR_6,  0, 8,    8);
    tgt_r2           = get_pvar(SPVAR_7,  0, 8,    8);
    tgt_cross        = get_pvar(SPVAR_8,  0, 8,    8);
    tgt_circle       = get_pvar(SPVAR_9,  0, 8,    8);
    tgt_square       = get_pvar(SPVAR_10, 0, 8,    8);
    tgt_triangle     = get_pvar(SPVAR_11, 0, 8,    8);
    mod_finesse      = get_pvar(SPVAR_12, 0, 1,    0);
    finesse_power    = get_pvar(SPVAR_13, 50, 1500, 265);
    finesse_shortcut = get_pvar(SPVAR_40, 0, 19,   19);
    mod_trivela      = get_pvar(SPVAR_16, 0, 1,    0);
    trivela_power    = get_pvar(SPVAR_17, 50, 1500, 265);
    trivela_shortcut = get_pvar(SPVAR_41, 0, 19,   19);
    mod_skills       = get_pvar(SPVAR_19, 0, 1,    0);
    sk_mcgeady_l     = get_pvar(SPVAR_30, 0, 19,   19);
    sk_mcgeady_r     = get_pvar(SPVAR_31, 0, 19,   19);
    sk_flair_nut     = get_pvar(SPVAR_32, 0, 19,   19);
    finesse_dbl_btn  = get_pvar(SPVAR_42, 0, 19,   19);
    trivela_dbl_btn  = get_pvar(SPVAR_43, 0, 19,   19);
    sk_mcgeady_l_dbl = get_pvar(SPVAR_44, 0, 19,   19);
    sk_mcgeady_r_dbl = get_pvar(SPVAR_45, 0, 19,   19);
    sk_flair_nut_dbl = get_pvar(SPVAR_46, 0, 19,   19);
}

//==============================================================================
//  MAIN
//==============================================================================
main {
    if(!splash_done) {
        if(splash_timer == 0) {
            cls_oled(0);
            draw_frame();
            print(center_x(12, OLED_FONT_SMALL_WIDTH), 10,
                  OLED_FONT_SMALL, OLED_WHITE, STR_TITLE[0]);
            print(center_x(8, OLED_FONT_SMALL_WIDTH), 40,
                  OLED_FONT_SMALL, OLED_WHITE, STR_AUTHOR[0]);
            colourled(LED_BLUE);
        }
        splash_timer = splash_timer + get_rtime();
        if(splash_timer >= 2500) {
            splash_done = TRUE;
            cls_oled(0);
            colourled(LED_GREEN);
        }
    } else {
        if(get_val(PaceCtrol) && event_press(PS4_PS)) {
            script_on = !script_on;
            cls_oled(0);
            if(script_on) {
                colourled(LED_GREEN);
                print(center_x(9, OLED_FONT_SMALL_WIDTH), 25,
                      OLED_FONT_SMALL, OLED_WHITE, STR_SCRIPT_ON[0]);
            } else {
                colourled(LED_RED);
                print(center_x(10, OLED_FONT_SMALL_WIDTH), 25,
                      OLED_FONT_SMALL, OLED_WHITE, STR_SCRIPT_OFF[0]);
            }
            set_val(PS4_PS, 0);
            saver_timer = 0;
            screen_saver = FALSE;
        }

        if(script_on) {
            if(get_val(PaceCtrol) && event_press(PS4_OPTIONS)) {
                menu_open = !menu_open;
                edit_open = FALSE;
                menu_timer = MENU_TIMEOUT;
                need_redraw = TRUE;
                if(!menu_open) {
                    save_settings();
                    cls_oled(0);
                    print(center_x(5, OLED_FONT_SMALL_WIDTH), 18,
                          OLED_FONT_SMALL, OLED_WHITE, STR_SAVED[0]);
                    saver_timer = 0;
                    screen_saver = FALSE;
                }
                set_val(PS4_OPTIONS, 0);
            }

            if(menu_open) {
                block_all_inputs();
                handle_menu_input();
                if(need_redraw) {
                    draw_menu();
                    need_redraw = FALSE;
                }
                menu_timer = menu_timer - get_rtime();
                if(menu_timer <= 0) {
                    menu_open = FALSE;
                    edit_open = FALSE;
                    save_settings();
                    cls_oled(0);
                }
            } else {
                run_features();
            }
        }
    }
}

//==============================================================================
//  FEATURES
//==============================================================================
function run_features() {
    if(!screen_saver) {
        saver_timer = saver_timer + get_rtime();
        if(saver_timer >= SCREEN_SAVER_MS) {
            cls_oled(0);
            screen_saver = TRUE;
        }
    }

    if(mod_remap) apply_remap();

    if(mod_sprint) {
        if(get_val(SprintBtn) > 0 && get_val(PaceCtrol) > 0) {
            set_val(SprintBtn, sprint_power);
            set_val(PaceCtrol, 0);
        }
    }

    // كشف السحبات أولاً إذا أي مود يحتاجها (شورت أو دبل تاب)
    if((mod_finesse && finesse_shortcut >= 11 && finesse_shortcut <= 14) ||
       (mod_finesse && finesse_dbl_btn  >= 11 && finesse_dbl_btn  <= 14) ||
       (mod_trivela && trivela_shortcut >= 11 && trivela_shortcut <= 14) ||
       (mod_trivela && trivela_dbl_btn  >= 11 && trivela_dbl_btn  <= 14) ||
       (mod_skills  && any_skill_uses_swipe())) {
        detect_swipes();
    }

    if(mod_finesse) {
        // الفينس يستهلك السحبة إن كانت اختصاره (يمسح last_swipe داخل check)
        if(check_finesse_shortcut()) combo_run(FinesseCombo);

        // دبل تاب لزر معين
        if(check_finesse_dbl_tap()) combo_run(FinesseCombo);

        // Cap على SQUARE فقط (مع R1)
        if(get_val(PS4_R1) && get_val(PS4_SQUARE) && get_ptime(PS4_SQUARE) >= finesse_power) {
            set_val(PS4_SQUARE, 0);
        }
    }

    if(mod_trivela) {
        // الترافيلا يستهلك السحبة إن كانت اختصاره
        if(check_trivela_shortcut()) combo_run(TrivelaCombo);

        // دبل تاب لزر معين
        if(check_trivela_dbl_tap()) combo_run(TrivelaCombo);

        // Cap على SQUARE (مع L2)
        if(get_val(PS4_L2) && get_val(PS4_SQUARE) && get_ptime(PS4_SQUARE) >= trivela_power) {
            set_val(PS4_SQUARE, 0);
        }
    }

    // Skills mod: كل مهارة تتفعل بضغطة الـ Shortcut الخاص بها
    if(mod_skills) run_skills();
}

//==============================================================================
//  TOUCHPAD SWIPES
//==============================================================================
function detect_swipes() {
    touch_is_active = ps4_touchpad(PS4T_P1);
    touch_now_x = ps4_touchpad(PS4T_P1X);
    touch_now_y = ps4_touchpad(PS4T_P1Y);
    last_swipe = 0;

    // بداية اللمس
    if(touch_is_active && !touch_was_active) {
        swipe_start_x = touch_now_x;
        swipe_start_y = touch_now_y;
    }

    // أثناء اللمس: تحديث آخر موضع
    if(touch_is_active) {
        swipe_last_x = touch_now_x;
        swipe_last_y = touch_now_y;
    }

    // نهاية اللمس: حساب اتجاه السحبة وتخزينه في last_swipe
    if(!touch_is_active && touch_was_active) {
        swipe_dx = swipe_last_x - swipe_start_x;
        swipe_dy = swipe_last_y - swipe_start_y;

        if(abs(swipe_dx) > abs(swipe_dy)) {
            if(swipe_dx > SWIPE_THRESHOLD)       last_swipe = 4;  // right
            else if(swipe_dx < -SWIPE_THRESHOLD) last_swipe = 3;  // left
        } else {
            if(swipe_dy > SWIPE_THRESHOLD)       last_swipe = 2;  // down
            else if(swipe_dy < -SWIPE_THRESHOLD) last_swipe = 1;  // up
        }
    }

    touch_was_active = touch_is_active;
}

//==============================================================================
//  FINESSE SHOT
//==============================================================================
combo FinesseCombo {
    set_val(PS4_R1, 100);
    set_val(PS4_SQUARE, 100);
    wait(finesse_power);
    set_val(PS4_R1, 0);
    set_val(PS4_SQUARE, 0);
}

combo TrivelaCombo {
    set_val(PS4_L2, 100);
    set_val(PS4_SQUARE, 100);
    wait(trivela_power);
    set_val(PS4_L2, 0);
    set_val(PS4_SQUARE, 0);
}

//==============================================================================
//  SKILLS COMBOS
//==============================================================================
// Spin "Smart" v2: 3 خطوات — أمام (LS direction) → منتصف → يسار/يمين نسبي
combo SkillMcGeadySmart {
    set_val(PS4_RX, spin_step1_x);
    set_val(PS4_RY, spin_step1_y);
    wait(100);
    set_val(PS4_RX, 0);
    set_val(PS4_RY, 0);
    wait(40);
    set_val(PS4_RX, spin_step2_x);
    set_val(PS4_RY, spin_step2_y);
    wait(120);
    set_val(PS4_RX, 0);
    set_val(PS4_RY, 0);
    wait(60);
}

//==============================================================================
//  SMART SPIN — تدوير حركة RS حسب اتجاه LS (Continuous / دقة كاملة)
//==============================================================================
// نقرأ LX/LY مباشرة (بدون snap لـ zones).
// مصفوفة الدوران تُحسب من قيم LS الخام:
//   prx = -ly,  pry = lx,  pdx = -lx,  pdy = -ly
// التحويل: world_x = (px * prx + py * pdx) / 100
//          world_y = (px * pry + py * pdy) / 100
function detect_ls_zone() {
    ls_lx_snap = get_val(PS4_LX);
    ls_ly_snap = get_val(PS4_LY);

    // Deadzone: إذا LS في المنتصف، اعتبره غير نشط
    if(abs(ls_lx_snap) < 25 && abs(ls_ly_snap) < 25) {
        ls_zone = -1;
    } else {
        ls_zone = 0;  // نشط (أي قيمة ≥ 0 تعني نشط)
    }
}

// تحويل قيم player frame (px, py) إلى world frame باستخدام LS الخام
function transform_to_world(px, py) {
    if(ls_zone < 0) {
        rot_world_x = px;
        rot_world_y = py;
    } else {
        rot_world_x = (px * (-ls_ly_snap) + py * (-ls_lx_snap)) / 100;
        rot_world_y = (px *   ls_lx_snap  + py * (-ls_ly_snap)) / 100;
    }
}

// إطلاق Spin Left: Step1 = forward، Step3 = 90° يسار عن Step 1 (نسبي)
function fire_mcgeady_l() {
    detect_ls_zone();
    if(ls_zone >= 0) {
        transform_to_world(0, -100);
        spin_step1_x = rot_world_x;
        spin_step1_y = rot_world_y;
        transform_to_world(-100, 0);
        spin_step2_x = rot_world_x;
        spin_step2_y = rot_world_y;
        combo_run(SkillMcGeadySmart);
    }
}

// إطلاق Spin Right: Step1 = forward، Step3 = 90° يمين عن Step 1 (نسبي)
function fire_mcgeady_r() {
    detect_ls_zone();
    if(ls_zone >= 0) {
        transform_to_world(0, -100);
        spin_step1_x = rot_world_x;
        spin_step1_y = rot_world_y;
        transform_to_world(100, 0);
        spin_step2_x = rot_world_x;
        spin_step2_y = rot_world_y;
        combo_run(SkillMcGeadySmart);
    }
}

// Flair Nutmeg: L1+R1 → ضغطة SQUARE → R2+L2 للـ Cancel
combo SkillFlairNutmegSmart {
    // Step 1: L1 + R1 + RS أمام (Up)
    set_val(PS4_L1, 100);
    set_val(PS4_R1, 100);
    set_val(PS4_RY, -100);
    wait(100);
    set_val(PS4_L1, 0);
    set_val(PS4_R1, 0);
    set_val(PS4_RY, 0);
    wait(100);

    // Step 2: SQUARE wind-up (يبدأ التسديدة)
    set_val(PS4_SQUARE, 100);
    wait(200);
    set_val(PS4_SQUARE, 0);
    wait(50);

    // Step 3: R2 + L2 ضغطة سريعة (تلغي التسديدة - Fake Shot)
    set_val(PS4_R2, 100);
    set_val(PS4_L2, 100);
    wait(50);
    set_val(PS4_R2, 0);
    set_val(PS4_L2, 0);
    wait(60);
}

function fire_flair_nut() {
    combo_run(SkillFlairNutmegSmart);
}

//==============================================================================
//  SKILLS HANDLERS
//==============================================================================
function run_skills() {
    if(check_shortcut_press(sk_mcgeady_l)) fire_mcgeady_l();
    if(check_shortcut_press(sk_mcgeady_r)) fire_mcgeady_r();
    if(check_shortcut_press(sk_flair_nut)) fire_flair_nut();

    // Dbl-Tap لكل مهارة (نمط الفينس)
    if(check_sk_mcg_l_dbl_tap())   fire_mcgeady_l();
    if(check_sk_mcg_r_dbl_tap())   fire_mcgeady_r();
    if(check_sk_flair_dbl_tap())   fire_flair_nut();
}

function check_shortcut_press(sh_idx) {
    if(sh_idx == SH_DISABLED) return 0;
    if(sh_idx == 0  && event_press(PS4_L1))       return 1;
    if(sh_idx == 1  && event_press(PS4_R1))       return 1;
    if(sh_idx == 2  && event_press(PS4_L2))       return 1;
    if(sh_idx == 3  && event_press(PS4_R2))       return 1;
    if(sh_idx == 4  && event_press(PS4_CROSS))    return 1;
    if(sh_idx == 5  && event_press(PS4_CIRCLE))   return 1;
    if(sh_idx == 6  && event_press(PS4_SQUARE))   return 1;
    if(sh_idx == 7  && event_press(PS4_TRIANGLE)) return 1;
    if(sh_idx == 8  && event_press(PS4_L3))       return 1;
    if(sh_idx == 9  && event_press(PS4_R3))       return 1;
    if(sh_idx == 10 && event_press(PS4_TOUCH))    return 1;
    if(sh_idx == 11 && last_swipe == 1) { last_swipe = 0; return 1; }
    if(sh_idx == 12 && last_swipe == 2) { last_swipe = 0; return 1; }
    if(sh_idx == 13 && last_swipe == 3) { last_swipe = 0; return 1; }
    if(sh_idx == 14 && last_swipe == 4) { last_swipe = 0; return 1; }
    if(sh_idx == 15 && event_press(PS4_UP))       return 1;
    if(sh_idx == 16 && event_press(PS4_DOWN))     return 1;
    if(sh_idx == 17 && event_press(PS4_LEFT))     return 1;
    if(sh_idx == 18 && event_press(PS4_RIGHT))    return 1;
    return 0;
}

function any_skill_uses_swipe() {
    if(sk_mcgeady_l     >= 11 && sk_mcgeady_l     <= 14) return 1;
    if(sk_mcgeady_r     >= 11 && sk_mcgeady_r     <= 14) return 1;
    if(sk_flair_nut     >= 11 && sk_flair_nut     <= 14) return 1;
    if(sk_mcgeady_l_dbl >= 11 && sk_mcgeady_l_dbl <= 14) return 1;
    if(sk_mcgeady_r_dbl >= 11 && sk_mcgeady_r_dbl <= 14) return 1;
    if(sk_flair_nut_dbl >= 11 && sk_flair_nut_dbl <= 14) return 1;
    return 0;
}

// skill_idx 0..2 = المهارة | skill_field 0=Short, 1=Dbl
function skill_real_idx() {
    return skill_idx;
}

function skill_field_is_dbl() {
    return skill_field;
}

function get_skill_field_value() {
    if(skill_field == 0) {
        if(skill_idx == 0) return sk_mcgeady_l;
        if(skill_idx == 1) return sk_mcgeady_r;
        if(skill_idx == 2) return sk_flair_nut;
    } else {
        if(skill_idx == 0) return sk_mcgeady_l_dbl;
        if(skill_idx == 1) return sk_mcgeady_r_dbl;
        if(skill_idx == 2) return sk_flair_nut_dbl;
    }
    return 0;
}

function set_skill_field_value(val) {
    if(skill_field == 0) {
        if(skill_idx == 0)      sk_mcgeady_l = val;
        else if(skill_idx == 1) sk_mcgeady_r = val;
        else if(skill_idx == 2) sk_flair_nut = val;
    } else {
        if(skill_idx == 0)      sk_mcgeady_l_dbl = val;
        else if(skill_idx == 1) sk_mcgeady_r_dbl = val;
        else if(skill_idx == 2) sk_flair_nut_dbl = val;
    }
}

function cycle_skill_field(dir) {
    cycle_tmp = get_skill_field_value() + dir;
    if(skill_field_is_dbl()) {
        if(cycle_tmp > DBL_OFF) cycle_tmp = 0;
        if(cycle_tmp < 0) cycle_tmp = DBL_OFF;
    } else {
        if(cycle_tmp > SH_DISABLED) cycle_tmp = 0;
        if(cycle_tmp < 0) cycle_tmp = SH_DISABLED;
    }
    set_skill_field_value(cycle_tmp);
}

function print_skill_name(idx, x, y, font) {
    if(idx == 0)      print(x, y, font, OLED_WHITE, SK_MCGEADY_L[0]);
    else if(idx == 1) print(x, y, font, OLED_WHITE, SK_MCGEADY_R[0]);
    else if(idx == 2) print(x, y, font, OLED_WHITE, SK_FLAIR_NUT[0]);
}

