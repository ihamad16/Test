define SWIPE_THRESHOLD  = 30;       // الحد الأدنى لاعتبار الحركة سحبة
define SKILLS_COUNT     = 3;
define DBL_TAP_WINDOW   = 300;      // النافذة الزمنية للدبل تاب (ms)
define DBL_OFF          = 19;       // 0..10 = أزرار، 11..14 = سحبات، 15..18 = D-pad، 19 = Off

// LED Colors
define LED_OFF    = 0;
define LED_BLUE   = 1;
define LED_RED    = 2;
define LED_GREEN  = 3;
define LED_PINK   = 4;
define LED_CYAN   = 5;
