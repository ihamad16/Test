//==============================================================================
//  FC 26 - Sprint + Remap + Finesse v5.0
//  Author      : Hamad
//  Platform    : PlayStation (PS4/PS5)
//  Device      : Cronus Zen
//==============================================================================
//
//  قائمة التحكم:
//  L2 + PS         → تشغيل/إطفاء السكريبت كاملاً
//  L2 + OPTIONS    → فتح/إغلاق القائمة
//
//  في القائمة (عرض المودات):
//  ↑/↓             → التنقل بين المودات
//  ←/→             → ON/OFF للمود الحالي
//  CROSS (X)       → دخول وضع التعديل
//  CIRCLE (O)      → خروج + حفظ
//
//  في وضع التعديل:
//  Mod 1 (Sprint):  ←/→ = ±10  |  ↑/↓ = ±1
//  Mod 2 (Remap):   ↑/↓ = تغيير الزر  |  ←/→ = تغيير وظيفته
//  Mod 3 (Finesse): ↑/↓ = تبديل الخيار  |  ←/→ = تغيير القيمة
//
//  المودات:
//  [1] Button Remap   → كل زر يتحول لأي زر آخر
//  [2] Finesse Shot   → R1+SQUARE — Power + Shortcut
//  [3] Trivela Shot   → L2+SQUARE — Power + Shortcut
//  [4] Sprint Control → R2+L2 = جري بنسبة (10..100)
//  [5] Skills         → McGeady L/R + Flair Nutmeg (Fake Shot)
//
//==============================================================================

//------------------------------------------------------------------------------
// BUTTON LAYOUT (PS Classic)
//------------------------------------------------------------------------------
define SprintBtn    = PS4_R2;
define PaceCtrol    = PS4_L2;

